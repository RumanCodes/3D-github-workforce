{
  "name": "@workforce/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start": "node dist/main.js",
    "start:api": "ROLE=api node dist/main.js",
    "start:worker": "ROLE=worker node dist/main.js",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "backfill": "tsx scripts/backfill.ts",
    "office-demo": "tsx scripts/office-demo.ts",
    "local:admin": "tsx scripts/local-admin.ts",
    "test:local": "WORKFORCE_TEST_MEMORY=true vitest run test/pipeline.test.ts test/office.integration.test.ts test/activity.test.ts test/polling.test.ts test/github-readonly.test.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/websockets": "11.2.7",
    "@workforce/contracts": "workspace:*",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.44.7",
    "ioredis": "5.11.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.5",
    "socket.io-client": "4.8.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.7",
    "@electric-sql/pglite": "0.5.13"
  }
}
