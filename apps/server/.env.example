DATABASE_URL=postgresql://postgres@localhost:5432/workforce
REDIS_URL=redis://localhost:6379
# Namespace for queues and realtime messages (change it if several deployments share one Redis)
REDIS_PREFIX=workforce
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Shared secret configured on the GitHub App / org webhook
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
# Optional: token with read access to your repos, used only for backfill
GITHUB_TOKEN=
# GitHub OAuth app for sign-in (leave empty locally to use dev sign-in)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Only for local development: allows choosing a seeded employee on the sign-in page
DEV_AUTH=true
# api | worker | all
ROLE=all

# GitHub App (private key may use literal \n between PEM lines)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Company organization slug and first administrator (GitHub username)
GITHUB_ORG=
BOOTSTRAP_ADMIN_LOGINS=

# Fetch contributions without a public webhook endpoint
GITHUB_POLL_ENABLED=true

# Alternative to an inline private key: absolute path to the downloaded PEM file
GITHUB_APP_PRIVATE_KEY_PATH=
