{
  "name": "workforce",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @workforce/contracts build && pnpm -r --parallel --filter \"./apps/**\" dev",
    "db:migrate": "pnpm --filter @workforce/server db:migrate",
    "db:seed": "pnpm --filter @workforce/server seed",
    "simulate": "pnpm --filter @workforce/server simulate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "office-demo": "pnpm --filter @workforce/server office-demo",
    "local:doctor": "node scripts/local-doctor.mjs",
    "local:setup": "pnpm db:migrate && pnpm --filter @workforce/server local:admin",
    "demo": "pnpm --filter @workforce/contracts build && pnpm --filter @workforce/web dev",
    "test:local": "pnpm --filter @workforce/server test:local && pnpm --filter @workforce/web test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver",
      "@swc/core"
    ]
  }
}
